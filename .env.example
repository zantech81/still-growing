# Still Growing — environment variables
# This is a SEPARATE Supabase project and SEPARATE keys from Chegu.my.
# Never copy Chegu's keys here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mux — use a dedicated key/environment for Still Growing, not Chegu's.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Systeme.io — dedicated key for Still Growing (marketing-capture only;
# does NOT verify purchases -- see SYSTEME_WEBHOOK_SECRET below for that).
SYSTEME_API_KEY=

# Secret configured in Systeme.io under Settings > Webhooks, used to
# HMAC-verify incoming "new sale" / "canceled sale or refund" events at
# /api/webhooks/systeme (see that route for detail + caveats on the exact
# header/payload assumptions). Feeds the `purchases` table, which is the
# real-sales side of reconciling against book_unlocks -- added 2026-08-20
# once the checkout-mechanism decision (staying Systeme.io-native, no
# external processor) made this worth building.
SYSTEME_WEBHOOK_SECRET=

# Resend — dedicated key scoped for Still Growing. Used by lib/sendgrid.ts
# (filename kept as-is to avoid touching its import sites; the provider
# switched from SendGrid to Resend on 2026-08-18, domain verified at
# stillgrowing.co / send.stillgrowing.co).
RESEND_API_KEY=

# Support inbox surfaced to readers whose reflection reads as product
# feedback/complaint rather than a chapter reflection (see lib/moderation.ts).
SUPPORT_EMAIL=

NEXT_PUBLIC_SITE_URL=https://stillgrowing.co

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# invokes /api/cron/birthdays (see vercel.json). Without this set, the route
# returns 401 for every request, including Vercel's own cron invocations.
CRON_SECRET=
